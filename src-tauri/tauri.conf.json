{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brutal Awake",
  "version": "1.0.0",
  "identifier": "com.vishalx0707.brutalawake",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brutal Awake",
        "width": 360,
        "height": 480,
        "minWidth": 320,
        "minHeight": 440,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
